# pnpm v11 supply-chain security config
# Reject packages published less than 24 hours ago (1440 minutes).
# This guard neutralizes same-day supply-chain attacks (e.g. TanStack 2026-05-11).
minimumReleaseAge=1440

# NOTE: In pnpm v11, lifecycle-script blocking is controlled via pnpm-workspace.yaml
# (allowBuilds map + strictDepBuilds: true), NOT via .npmrc.
# The spec originally said "allowBuilds=" here, but that key is NOT valid in .npmrc
# for pnpm v11 — it is a YAML map in pnpm-workspace.yaml.
# See: https://pnpm.io/settings#allowbuilds
# Verified 2026-06-21 against pnpm v11.1.2 docs via context7.
