// Cloudflare Pages deploy config (D6 — setup-stack)
// Docs: https://developers.cloudflare.com/pages/functions/wrangler-configuration/
//
// This file configures the Cloudflare Pages project build.
// It is NOT a Workers config — Antimahue is a pure static SPA (REQ-SETUP-11).
//
// To deploy manually:
//   pnpm dlx wrangler pages deploy dist --project-name antimahue
//
// CF Pages dashboard setup (task 5.3 — requires human with CF credentials):
//   1. Connect repo at https://dash.cloudflare.com → Pages → Create project → Connect to Git
//   2. Set "Build command":          pnpm build
//   3. Set "Build output directory": dist
//   4. Set env vars in Pages settings (NOT in this file):
//        VITE_SUPABASE_URL      → <your Supabase project URL>
//        VITE_SUPABASE_ANON_KEY → <your Supabase anon key>
//      NEVER add SUPABASE_SERVICE_ROLE_KEY here (REQ-SETUP-9, T4).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antimahue",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-06-21"
}
